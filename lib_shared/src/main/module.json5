{
  "module": {
    "name": "lib_shared",
    "type": "shared",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "routerMap": "$profile:route_map",
    "abilities": [
      {
        "name": "OvdSharedAbility",
        "srcEntry": "./ets/OvdSharedAbility.ets",
        "description": "$string:OvdSharedAbility_desc",
        "icon": "$media:startIcon",
        "label": "$string:OvdSharedAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      }
    ]
  }
}
