{
  "app": {
    "signingConfigs": [],
    "products": [
      // hvigor 强制要求存在名为 "default" 的 product；default 即 api26（正式语料）
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "nativeCompiler": "BiSheng",
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "api24",
        "signingConfig": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "nativeCompiler": "BiSheng",
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "api24"
          ]
        }
      ]
    },
    {
      "name": "feat_api",
      "srcPath": "./feat_api",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "api24"
          ]
        }
      ]
    },
    {
      "name": "feat_vuln",
      "srcPath": "./feat_vuln",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "api24"
          ]
        }
      ]
    },
    {
      "name": "lib_common",
      "srcPath": "./lib_common",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "api24"
          ]
        }
      ]
    },
    {
      "name": "lib_shared",
      "srcPath": "./lib_shared",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "api24"
          ]
        }
      ]
    }
  ]
}
