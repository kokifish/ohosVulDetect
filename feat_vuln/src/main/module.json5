{
  "module": {
    "name": "feat_vuln",
    "type": "feature",
    "description": "$string:module_desc",
    "mainElement": "VulnAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:perm_location_reason",
        "usedScene": {
          "abilities": [
            "VulnAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:perm_location_reason",
        "usedScene": {
          "abilities": [
            "VulnAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:perm_location_reason",
        "usedScene": {
          "abilities": [
            "VulnAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:perm_location_reason",
        "usedScene": {
          "abilities": [
            "VulnAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "VulnAbility",
        "srcEntry": "./ets/abilities/VulnAbility.ets",
        "description": "$string:VulnAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:VulnAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false
      },
      {
        "name": "BackdoorAbility",
        "srcEntry": "./ets/abilities/BackdoorAbility.ets",
        "description": "$string:BackdoorAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:BackdoorAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "ovd",
                "host": "backdoor"
              }
            ]
          }
        ]
      }
    ]
  }
}
